# PDF Max Android Release Signing
# Add each value below as a GitHub Actions repository secret.
# Never commit the real values or the .jks/.keystore file to the repository.

ANDROID_KEYSTORE_BASE64=<BASE64_CONTENT_OF_PDFMAX_RELEASE_JKS>
ANDROID_KEYSTORE_PASSWORD=<KEYSTORE_PASSWORD>
ANDROID_KEY_ALIAS=pdfmax-upload
ANDROID_KEY_PASSWORD=<KEY_PASSWORD>

# GitHub:
# Repository -> Settings -> Secrets and variables -> Actions -> New repository secret
# Create the four secrets above with these exact names.
